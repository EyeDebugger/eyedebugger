# Normalize text to LF in the repository and in every working tree, so golden
# files and generated output compare byte-for-byte on Windows too.
* text=auto eol=lf

# Windows command scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.exe binary
*.dll binary
*.pdb binary
*.nupkg binary
