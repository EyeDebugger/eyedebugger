<?xml version="1.0" encoding="utf-8"?>
<!-- One package source, mapped for every package, and the same source for audit data
     (docs/adr/0016-a-csharp-side-helper-for-dotnet-diagnostics.md). -->
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
    <packageSourceMapping>
        <clear />
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
    <auditSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </auditSources>
</configuration>
