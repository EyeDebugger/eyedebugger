<Project Sdk="Microsoft.NET.Sdk">

    <!-- The .NET side helper run by 'eyedbg dotnet …' (helpers/dotnet/README.md).
         Framework-dependent net8.0, rolled forward to the newest installed runtime. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <RollForward>LatestMajor</RollForward>
        <AssemblyName>eyedbg-dotnet-helper</AssemblyName>
        <RootNamespace>EyeDbg.DotnetHelper</RootNamespace>
        <UseAppHost>false</UseAppHost>
        <InvariantGlobalization>true</InvariantGlobalization>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <DebugType>embedded</DebugType>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <!-- The eyedbg version the helper ships with; release builds pass -p:InformationalVersion. -->
        <InformationalVersion Condition="'$(InformationalVersion)' == ''">0.0.0-dev</InformationalVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" />
        <!-- ClrMD: reads dumps for 'eyedbg dotnet heap|threads' (ADR 0016 addendum, P2-M7). -->
        <PackageReference Include="Microsoft.Diagnostics.Runtime" />
        <!-- build/buildTransitive would copy Windows-only native ETW/DIA libraries (~10 MB)
             that EventPipe parsing doesn't use. -->
        <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" ExcludeAssets="build;buildTransitive" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../../THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="PreserveNewest" />
        <InternalsVisibleTo Include="EyeDbg.DotnetHelper.Tests" />
    </ItemGroup>

</Project>
